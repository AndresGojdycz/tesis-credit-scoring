# Credit Scoring API - Variables de entorno
# Copiar este archivo como `.env` y completar los valores.

# OpenAI (requerido para generar resumenes en lenguaje natural de LIME)
# Obtener una key en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo OpenAI a usar para los resumenes (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Entorno: "development" o "production". Habilita DEBUG en development.
ENVIRONMENT=development
